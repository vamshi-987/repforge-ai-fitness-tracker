# Copy to .env (make up does this for you). Values here are for local development only.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# Host ports, chosen to avoid clashing with other local stacks.
API_PORT=8010
POSTGRES_PORT=5442
REDIS_PORT=6389
S3_PORT=9010

# Postgres container credentials
POSTGRES_USER=repforge
POSTGRES_PASSWORD=repforge
POSTGRES_DB=repforge

# URLs as seen from the host (local venv, tests). docker-compose overrides
# these with in-network hostnames for the api/worker/beat containers.
DATABASE_URL=postgresql+asyncpg://repforge:repforge@localhost:5442/repforge
TEST_DATABASE_URL=postgresql+asyncpg://repforge:repforge@localhost:5442/repforge_test
REDIS_URL=redis://localhost:6389/0
CELERY_BROKER_URL=redis://localhost:6389/1
CELERY_RESULT_BACKEND=redis://localhost:6389/2

# S3-compatible storage (SeaweedFS in dev, Cloudflare R2 in prod).
# Buckets: media, food-photos, avatars, progress-photos
# Dev keys must match infra/seaweedfs/s3.json.
S3_ENDPOINT_URL=http://localhost:9010
S3_ACCESS_KEY=repforge
S3_SECRET_KEY=repforge-secret
# Address phones use for signed upload/download URLs (the signature covers the host).
# For a physical phone, set your computer's LAN IP, e.g. http://192.168.1.20:9010.
S3_PUBLIC_URL=http://localhost:9010

# Auth. In prod set a random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
# OAuth audiences as JSON lists (iOS/Android/web client IDs; Apple: bundle / service IDs).
# An empty list disables that provider, and its endpoint returns 503 provider_not_configured.
GOOGLE_CLIENT_IDS=[]
APPLE_CLIENT_IDS=[]
# Login/register/social sign-in attempts per client IP per window.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_S=900

# Routines a free account may keep; Pro is unlimited.
FREE_ROUTINE_LIMIT=4

# USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup). Empty = DEMO_KEY,
# limited to 30 requests an hour per IP; get a free key for real use.
USDA_FDC_API_KEY=

# RevenueCat webhook: the same value goes in its Authorization header setting.
REVENUECAT_WEBHOOK_SECRET=

# Error tracking; empty turns it off.
SENTRY_DSN=
# Bearer token for GET /metrics. Required in production, where /metrics is off without it.
METRICS_TOKEN=

# Only if your Expo project has enhanced push security turned on.
EXPO_ACCESS_TOKEN=

# Claude API (https://platform.claude.com). Empty turns the AI off: coaching shows its numbers
# with template tips, and food photos and free text answer 503 so the app offers manual entry.
ANTHROPIC_API_KEY=
