{
  "expo": {
    "name": "RepForge",
    "slug": "repforge",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.repforge.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#18181B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.repforge.mobile",
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.WRITE_EXERCISE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "RepForge uses the camera to scan food barcodes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "RepForge reads your weight so your trend and calorie targets stay up to date.",
          "NSHealthUpdateUsageDescription": "RepForge saves your finished workouts to Apple Health.",
          "background": false
        }
      ],
      "expo-health-connect",
      "@sentry/react-native/expo"
    ],
    "scheme": "repforge"
  }
}
